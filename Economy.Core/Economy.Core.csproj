<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <PublishDir>$(OutputPath)publish/Economy.Core</PublishDir>
        <PackageId>MS</PackageId>
        <RootNamespace>Economy.Core</RootNamespace>
        <PluginVersion>0.1.0</PluginVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.3">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"  PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0"  PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0"  PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0"  PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0"  PrivateAssets="all"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.3" />
        <PackageReference Include="SwiftlyS2.CS2" Version="1.4.6-beta.8" PrivateAssets="all">

            <ExcludeAssets Condition="'$(Configuration)' != 'Migrations'">
                runtime
            </ExcludeAssets>

            <IncludeAssets Condition="'$(Configuration)' != 'Migrations'">compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Content Include="resources/gamedata/**/*;resources/templates/**/*;resources/translations/**/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="examples\**\*.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Common.Database\Common.Database.csproj">
            <Private>true</Private>
        </ProjectReference>
        <ProjectReference Include="..\Common.Di\Common.Di.csproj">
            <Private Condition="'$(Configuration)' == 'Migrations'">true</Private>
        </ProjectReference>
        <ProjectReference Include="..\Common.Hooks\Common.Hooks.csproj" />

        <ProjectReference Include="..\Economy.Api\Economy.Api.csproj">
            <Private Condition="'$(Configuration)' == 'Migrations'">true</Private>
        </ProjectReference>

        <ProjectReference Include="..\ZombiePlague.Api\ZombiePlague.Api.csproj">
            <Private Condition="'$(Configuration)' == 'Migrations'">true</Private>
        </ProjectReference>
    </ItemGroup>

    <Target Name="CreateZip" AfterTargets="Publish">
        <ItemGroup>
            <PublishFiles Include="$(PublishDir)**\*.*"/>
        </ItemGroup>

        <ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName).zip" Overwrite="true"/>
    </Target>

    <ItemGroup>
        <VersionFileLines Include="namespace $(AssemblyName).Generated {&#x0D;&#x0A;%09internal static class BuildInfo {&#x0D;&#x0A;%09%09internal const string Version = %22$(PluginVersion)%22%3B&#x0D;&#x0A;%09}&#x0D;&#x0A;}"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="src\Database\Migrations\" />
    </ItemGroup>

    <Target Name="GenerateVersionFile" BeforeTargets="CoreCompile">
        <WriteLinesToFile
                File="$(IntermediateOutputPath)BuildInfo.cs"
                Lines="@(VersionFileLines)"
                Overwrite="true" />

        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)BuildInfo.cs" />
        </ItemGroup>
    </Target>

</Project> 
