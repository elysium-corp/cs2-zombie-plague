<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <PublishDir>$(OutputPath)publish/ZombiePlague.Core</PublishDir>
        <AssemblyName>ZombiePlague.Core</AssemblyName>
        <PluginVersion>0.3.1-hud.3</PluginVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Migrations'">
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <GenerateDependencyFile>true</GenerateDependencyFile>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.3">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.3" />

        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" PrivateAssets="all">
            <ExcludeAssets Condition="'$(Configuration)' != 'Migrations'">runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" PrivateAssets="all">
            <ExcludeAssets Condition="'$(Configuration)' != 'Migrations'">runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" PrivateAssets="all">
            <ExcludeAssets Condition="'$(Configuration)' != 'Migrations'">runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" PrivateAssets="all">
            <ExcludeAssets Condition="'$(Configuration)' != 'Migrations'">runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" PrivateAssets="all">
            <ExcludeAssets Condition="'$(Configuration)' != 'Migrations'">runtime</ExcludeAssets>
        </PackageReference>

        <PackageReference Include="SwiftlyS2.CS2" Version="1.4.9" PrivateAssets="all">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <ExcludeAssets Condition="'$(Configuration)' != 'Migrations'">runtime</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Content Include="resources/gamedata/**/*;resources/templates/**/*;resources/translations/**/*;resources/experimental/**/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="src/Catalog/*.sql" />
        <Compile Remove="examples\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Admin.Api\Admin.Api.csproj" />
        <ProjectReference Include="..\Common.Database\Common.Database.csproj">
            <Private>true</Private>
        </ProjectReference>
        <ProjectReference Include="..\Common.Di\Common.Di.csproj" />
        <ProjectReference Include="..\Common.Effects\Common.Effects.csproj" />
        <ProjectReference Include="..\Common.Hooks\Common.Hooks.csproj" />
        <ProjectReference Include="..\Localization.Api\Localization.Api.csproj" />
        <ProjectReference Include="..\Menu.Api\Menu.Api.csproj" />
        <ProjectReference Include="..\Metrics.Api\Metrics.Api.csproj" />
        <ProjectReference Include="..\ZombiePlague.Api\ZombiePlague.Api.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="resources\exports\" />
        <Folder Include="src\Data\Rounds\Exceptions\" />
    </ItemGroup>

    <ItemGroup>
        <VersionFileLines Include="namespace $(AssemblyName).Generated {&#xD;&#xA;%09internal static class BuildInfo {&#xD;&#xA;%09%09internal const string Version = %22$(PluginVersion)%22%3B&#xD;&#xA;%09}&#xD;&#xA;}" />
    </ItemGroup>

    <Target Name="GenerateVersionFile" BeforeTargets="CoreCompile">
        <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.cs" Lines="@(VersionFileLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)BuildInfo.cs" />
        </ItemGroup>
    </Target>

</Project>
