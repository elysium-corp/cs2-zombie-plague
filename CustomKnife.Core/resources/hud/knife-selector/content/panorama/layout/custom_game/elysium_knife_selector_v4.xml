                                        <Panel class="KnifeStatValues">
                                            <Label text="{s:value}" class="KnifeStatCurrent" id="StatCurrent2" hittest="false" />
                                            <Label text="→" class="KnifeStatArrow" hittest="false" />
                                            <Label text="{s:value}" class="KnifeStatSelected" id="StatSelected2" hittest="false" />
                                            <Label text="{s:value}" class="KnifeStatDelta" id="StatDelta2" hittest="false" />
                                        </Panel>
                                    </Panel>
                                    <Panel class="KnifeStatRow" id="StatRow3">
                                        <Label text="{s:value}" class="KnifeStatName" id="StatName3" hittest="false" />
                                        <Panel class="KnifeStatValues">
                                            <Label text="{s:value}" class="KnifeStatCurrent" id="StatCurrent3" hittest="false" />
                                            <Label text="→" class="KnifeStatArrow" hittest="false" />
                                            <Label text="{s:value}" class="KnifeStatSelected" id="StatSelected3" hittest="false" />
                                            <Label text="{s:value}" class="KnifeStatDelta" id="StatDelta3" hittest="false" />
                                        </Panel>
                                    </Panel>
                                </Panel>
                                <Panel class="KnifeDescriptionPanel">
                                    <Label text="{s:value}" class="KnifeSectionLabel" id="DescriptionTitle" hittest="false" />
                                    <Panel class="KnifeDescriptionScroll">
                                        <Label text="{s:value}" class="KnifeDescription" id="Description" hittest="false" />
                                    </Panel>
                                </Panel>
                            </Panel>
                            <Label text="{s:value}" class="KnifeEmpty" id="Empty" hittest="false" />
                        </Panel>
                    </Panel>
                    <Panel class="KnifeSettingsPanel">
                        <Label text="{s:value}" class="KnifeSectionLabel" id="SettingsTitle" hittest="false" />
                        <Panel class="KnifeScaleOptions">
                            <Button class="KnifeScaleOption" id="Scale75">
                                <Label text="75%" hittest="false" />
                            </Button>
                            <Button class="KnifeScaleOption" id="Scale85">
                                <Label text="85%" hittest="false" />
                            </Button>
                            <Button class="KnifeScaleOption" id="Scale100">
                                <Label text="100%" hittest="false" />
                            </Button>
                            <Button class="KnifeScaleOption" id="Scale115">
                                <Label text="115%" hittest="false" />
                            </Button>
                            <Button class="KnifeScaleOption" id="Scale125">
                                <Label text="125%" hittest="false" />
                            </Button>
                        </Panel>
                    </Panel>
                </Panel>
                <Panel class="KnifeFooter" id="Footer">
                    <Panel class="KnifeStatusDot" />
                    <Label text="{s:value}" class="KnifeStatus" id="FooterStatus" hittest="false" />
                    <Panel class="KnifeConfirm" id="Confirm">
                        <Label text="{s:value}" class="KnifeEquipLabel" id="EquipLabel" hittest="false" />
                        <Button class="KnifeEquipHit EquipSlot0" id="Equip0" />
                        <Button class="KnifeEquipHit EquipSlot1" id="Equip1" />
                        <Button class="KnifeEquipHit EquipSlot2" id="Equip2" />
                        <Button class="KnifeEquipHit EquipSlot3" id="Equip3" />
                        <Button class="KnifeEquipHit EquipSlot4" id="Equip4" />
                        <Button class="KnifeEquipHit EquipSlot5" id="Equip5" />
                        <Button class="KnifeEquipHit EquipSlot6" id="Equip6" />
