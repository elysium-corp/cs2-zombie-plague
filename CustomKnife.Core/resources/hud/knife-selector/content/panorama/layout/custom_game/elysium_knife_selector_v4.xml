<root>
    <styles>
        <include src="s2r://panorama/styles/custom_game/elysium_knife_selector_v4.vcss_c" />
        <include src="s2r://panorama/styles/custom_game/elysium_knife_images_v4.vcss_c" />
    </styles>
    <Panel hittest="false" class="KnifeViewport">
        <Panel class="KnifeRoot" id="KnifeRoot">
            <Panel class="KnifeWindow">
                <Panel class="KnifeHeader">
                    <Panel class="KnifeHeading">
                        <Label text="{s:value}" class="KnifeTitle" id="Title" hittest="false" />
                        <Label text="{s:value}" class="KnifeSubtitle" id="Subtitle" hittest="false" />
                    </Panel>
                    <Button class="KnifeSettingsButton" id="Settings">
                        <Panel hittest="false" class="KnifeGear" />
                    </Button>
                    <Button class="KnifeClose" id="Close">
                        <Label text="×" hittest="false" />
                    </Button>
                </Panel>
                <Panel class="KnifeContentStack">
                    <Panel class="KnifeBody">
                        <Panel class="KnifeList">
                            <Panel class="KnifeListHeader">
                                <Label text="{s:value}" class="KnifeSectionLabel KnifeListTitle" id="AvailableTitle" hittest="false" />
                                <Label text="{s:value}" class="KnifeCount" id="AvailableCount" hittest="false" />
                            </Panel>
                            <Panel class="KnifeRows">
                                <Panel class="KnifeRow" id="Row0">
                                    <Panel hittest="false" class="KnifeRowSurface">
                                        <Panel hittest="false" class="KnifeRowContent">
                                            <Panel hittest="false" class="KnifeThumb" id="Image0" />
                                            <Panel hittest="false" class="KnifeRowText">
                                                <Label text="{s:value}" class="KnifeName" id="Name0" hittest="false" />
                                                <Label text="{s:value}" class="KnifeRowAction" id="Action0" hittest="false" />
                                            </Panel>
                                            <Label text="✓" class="KnifeEquippedMark" hittest="false" />
                                        </Panel>
                                    </Panel>
                                    <Button class="KnifeRowHit" id="Preview0" />
                                </Panel>
                                <Panel class="KnifeRow" id="Row1">
                                    <Panel hittest="false" class="KnifeRowSurface">
                                        <Panel hittest="false" class="KnifeRowContent">
                                            <Panel hittest="false" class="KnifeThumb" id="Image1" />
                                            <Panel hittest="false" class="KnifeRowText">
                                                <Label text="{s:value}" class="KnifeName" id="Name1" hittest="false" />
                                                <Label text="{s:value}" class="KnifeRowAction" id="Action1" hittest="false" />
                                            </Panel>
                                            <Label text="✓" class="KnifeEquippedMark" hittest="false" />
                                        </Panel>
                                    </Panel>
                                    <Button class="KnifeRowHit" id="Preview1" />
                                </Panel>
                                <Panel class="KnifeRow" id="Row2">
                                    <Panel hittest="false" class="KnifeRowSurface">
                                        <Panel hittest="false" class="KnifeRowContent">
                                            <Panel hittest="false" class="KnifeThumb" id="Image2" />
                                            <Panel hittest="false" class="KnifeRowText">
                                                <Label text="{s:value}" class="KnifeName" id="Name2" hittest="false" />
                                                <Label text="{s:value}" class="KnifeRowAction" id="Action2" hittest="false" />
                                            </Panel>
                                            <Label text="✓" class="KnifeEquippedMark" hittest="false" />
                                        </Panel>
                                    </Panel>
                                    <Button class="KnifeRowHit" id="Preview2" />
                                </Panel>
                                <Panel class="KnifeRow" id="Row3">
                                    <Panel hittest="false" class="KnifeRowSurface">
                                        <Panel hittest="false" class="KnifeRowContent">
                                            <Panel hittest="false" class="KnifeThumb" id="Image3" />
                                            <Panel hittest="false" class="KnifeRowText">
                                                <Label text="{s:value}" class="KnifeName" id="Name3" hittest="false" />
                                                <Label text="{s:value}" class="KnifeRowAction" id="Action3" hittest="false" />
                                            </Panel>
                                            <Label text="✓" class="KnifeEquippedMark" hittest="false" />
                                        </Panel>
                                    </Panel>
                                    <Button class="KnifeRowHit" id="Preview3" />
                                </Panel>
                                <Panel class="KnifeRow" id="Row4">
                                    <Panel hittest="false" class="KnifeRowSurface">
                                        <Panel hittest="false" class="KnifeRowContent">
                                            <Panel hittest="false" class="KnifeThumb" id="Image4" />
                                            <Panel hittest="false" class="KnifeRowText">
                                                <Label text="{s:value}" class="KnifeName" id="Name4" hittest="false" />
                                                <Label text="{s:value}" class="KnifeRowAction" id="Action4" hittest="false" />
                                            </Panel>
                                            <Label text="✓" class="KnifeEquippedMark" hittest="false" />
                                        </Panel>
                                    </Panel>
                                    <Button class="KnifeRowHit" id="Preview4" />
                                </Panel>
                                <Panel class="KnifeRow" id="Row5">
                                    <Panel hittest="false" class="KnifeRowSurface">
                                        <Panel hittest="false" class="KnifeRowContent">
                                            <Panel hittest="false" class="KnifeThumb" id="Image5" />
                                            <Panel hittest="false" class="KnifeRowText">
                                                <Label text="{s:value}" class="KnifeName" id="Name5" hittest="false" />
                                                <Label text="{s:value}" class="KnifeRowAction" id="Action5" hittest="false" />
                                            </Panel>
                                            <Label text="✓" class="KnifeEquippedMark" hittest="false" />
                                        </Panel>
                                    </Panel>
                                    <Button class="KnifeRowHit" id="Preview5" />
                                </Panel>
                                <Panel class="KnifeRow Last" id="Row6">
                                    <Panel hittest="false" class="KnifeRowSurface">
                                        <Panel hittest="false" class="KnifeRowContent">
                                            <Panel hittest="false" class="KnifeThumb" id="Image6" />
                                            <Panel hittest="false" class="KnifeRowText">
                                                <Label text="{s:value}" class="KnifeName" id="Name6" hittest="false" />
                                                <Label text="{s:value}" class="KnifeRowAction" id="Action6" hittest="false" />
                                            </Panel>
                                            <Label text="✓" class="KnifeEquippedMark" hittest="false" />
                                        </Panel>
                                    </Panel>
                                    <Button class="KnifeRowHit" id="Preview6" />
                                </Panel>
                            </Panel>
                            <Panel class="KnifePager">
                                <Button class="KnifePageButton" id="PreviousPage">
                                    <Label text="‹" hittest="false" />
                                </Button>
                                <Label text="{s:value}" class="KnifePageLabel" id="PageLabel" hittest="false" />
                                <Button class="KnifePageButton" id="NextPage">
                                    <Label text="›" hittest="false" />
                                </Button>
                            </Panel>
                        </Panel>
                        <Panel class="KnifeRight">
                            <Panel class="KnifePreview" id="Preview">
                                <Panel class="KnifePreviewArt">
                                    <Panel hittest="false" class="KnifeHero" id="PreviewImage" />
                                </Panel>
                                <Panel class="KnifeCaption">
                                    <Label text="{s:value}" class="KnifePreviewName" id="PreviewName" hittest="false" />
                                    <Label text="{s:value}" class="KnifePreviewSubtitle" id="PreviewSubtitle" hittest="false" />
                                </Panel>
                            </Panel>
                            <Panel class="KnifeDetails">
                                <Panel class="KnifeStats">
                                    <Label text="{s:value}" class="KnifeSectionLabel" id="StatsTitle" hittest="false" />
                                    <Label text="{s:value}" class="KnifeComparisonHint" id="ComparisonHint" hittest="false" />
                                    <Panel class="KnifeStatRow" id="StatRow0">
                                        <Label text="{s:value}" class="KnifeStatName" id="StatName0" hittest="false" />
                                        <Panel class="KnifeStatValues">
                                            <Label text="{s:value}" class="KnifeStatCurrent" id="StatCurrent0" hittest="false" />
